# ---- Gold Market Live (Python) ----
# Copy to ".env". NEVER commit ".env".

APP_VERSION=1.0.0

# Database. For local dev, SQLite is the default (no setup). For production use
# PostgreSQL (docker-compose sets this automatically):
#   postgresql+psycopg2://gold:goldpass@db:5432/goldmarket
DATABASE_URL=sqlite:///./data.db

# Navasan — free-market USD/AED/gold/ounce (Toman). KEY REQUIRED for domestic prices.
# https://navasan.tech/  (bot: @navasan_contact_bot)
NAVASAN_API_KEY=

# BrsApi — alternative domestic source (optional; used only if no Navasan key).
BRSAPI_KEY=

PORT=8787
POSTGRES_PORT=5436
REFRESH_SEC=60
HTTP_TIMEOUT=8

# Outbound HTTP(S) proxy for providers (server-side only). Optional.
# Example (no auth): http://mtproxier.ir:2053
# Example (with auth): http://user:pass@proxy.example.com:2053
HTTP_PROXY=
HTTPS_PROXY=
OUTBOUND_HTTPS_PROXY=
NO_PROXY=db,localhost,127.0.0.1

# Keyless sources need no vars: Nobitex, Wallex (USDT), gold-api.com,
# goldprice.org, CoinGecko. Optional base-URL overrides:
# NOBITEX_URL, WALLEX_URL, GOLDAPI_URL, GOLDPRICEORG_URL, COINGECKO_URL, NAVASAN_URL, BRSAPI_URL
